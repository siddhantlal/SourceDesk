# Manual database configuration only. Automated setup_db.py creates its own private files.
# Never overwrite an existing .env. Replace EVERY placeholder before manual startup.
# Generate a secret: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SOURCEDESK_DATABASE_URL=postgresql+psycopg://sourcedesk:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/sourcedesk
SOURCEDESK_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
SOURCEDESK_UPLOAD_DIR=./data/uploads
# Fake mode is deterministic test scaffolding, not a real language model.
SOURCEDESK_PROVIDER=fake
SOURCEDESK_EMBEDDING_MODEL=text-embedding-3-small
SOURCEDESK_EMBEDDING_DIMENSIONS=1536
SOURCEDESK_GENERATION_MODEL=gpt-4.1-mini
SOURCEDESK_OPENAI_API_KEY=
SOURCEDESK_OPENAI_BASE_URL=https://api.openai.com/v1
# Same-origin frontend needs no CORS allowlist. For a separate trusted origin use a JSON array.
SOURCEDESK_CORS_ORIGINS=[]
# Defaults to the repository's frontend directory; optional explicit override:
# SOURCEDESK_FRONTEND_DIR=./frontend
# Render uses render.yaml, not this local file: injected Postgres URL + generated JWT secret.
# Both postgres:// and postgresql:// normalize only their scheme to postgresql+psycopg://.
# Native Render start: uv run --locked --no-dev python scripts/render_start.py
# SOURCEDESK_UPLOAD_DIR=/var/data/uploads
# TIKTOKEN_CACHE_DIR=/var/data/tiktoken
# PORT=10000
# Supervisor trusts forwarded headers ONLY from this explicit proxy IP/CIDR list.
# FORWARDED_ALLOW_IPS=127.0.0.1
# Optional OpenAI key is NOT required by fake mode; add it privately only when opting in.
# Back up and reindex all existing documents before enabling a different embedding provider.
# Never point this at development or personal data. Database name must contain test.
SOURCEDESK_TEST_DATABASE_URL=postgresql+psycopg://sourcedesk:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/sourcedesk_test
